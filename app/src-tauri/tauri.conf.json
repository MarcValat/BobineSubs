{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bobine Subs",
  "version": "1.1.0",
  "identifier": "com.syncsubtitles.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && cd ../engine && uv run python packaging/build_sidecar.py",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Bobine Subs",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "binaries/syncsubtitles-engine/": "engine/"
    },
    "windows": {
      "nsis": {
        "installerHooks": "./windows/installer-hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "sidebarImage": "./windows/installer-sidebar.bmp",
        "headerImage": "./windows/installer-header.bmp",
        "languages": [
          "English",
          "French"
        ],
        "displayLanguageSelector": false
      }
    },
    "shortDescription": "Recale des sous-titres sur ceux de référence d'une vidéo",
    "publisher": "Marc Valat",
    "createUpdaterArtifacts": true,
    "linux": {
      "deb": {
        "conflicts": ["sync-subtitles"],
        "replaces": ["sync-subtitles"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY5RDkwODY0RkE5ODIyQkYKUldTL0lwajZaQWpaK1ltUzZ4UVp0WXlLUWtHVDJDV1lLMFh6amJUSENsMUZjYmhtbWFsV1pyTzAK",
      "endpoints": [
        "https://github.com/MarcValat/BobineSubs/releases/latest/download/latest.json"
      ]
    }
  }
}
